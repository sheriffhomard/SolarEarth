# ==============================================================================
# Solar Earth Environment Configuration — V0.2 Local SQLite / Mobile Foundation
# Toutes les valeurs par défaut sont configurées et fonctionnelles sans clé secrète.
# ==============================================================================

# Application environment
# APP_ENV=development
# LOG_LEVEL=INFO
# DEBUG=false

# ------------------------------------------------------------------------------
# Database: Base locale SQLite 3 (aucune installation Docker ou cloud requise)
# ------------------------------------------------------------------------------
# DATABASE_URL=sqlite:///./solar_earth.db

# ------------------------------------------------------------------------------
# Fournisseurs de données solaires (PVGIS actif en V0.2)
# ------------------------------------------------------------------------------

# PVGIS (Commission Européenne JRC - API publique sans clé requise)
# PVGIS_BASE_URL=https://re.jrc.ec.europa.eu/api/v5_3/
# PVGIS_ENABLED=true

# NASA POWER (API publique, clé optionnelle)
# NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/
# NASA_POWER_ENABLED=false
# NASA_POWER_API_KEY=DEMO_KEY

# NOAA SWPC (Météo spatiale publique sans clé requise)
# NOAA_BASE_URL=https://services.swpc.noaa.gov/
# NOAA_ENABLED=false

# EUMETSAT Data Store (Prévu V0.7)
# EUMETSAT_BASE_URL=https://data.eumetsat.int/
# EUMETSAT_ENABLED=false
# EUMETSAT_CONSUMER_KEY=eumetsat_consumer_key_placeholder
# EUMETSAT_CONSUMER_SECRET=eumetsat_consumer_secret_placeholder

# ------------------------------------------------------------------------------
# Politiques HTTP & Quotas
# ------------------------------------------------------------------------------
# PROVIDER_REQUEST_TIMEOUT_SECONDS=15.0
# PROVIDER_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# Configuration Frontend & PWA
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL=/api/v1
# PORT=3000
