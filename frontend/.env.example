# ==============================================================================
# Solar Earth — Configuration des Variables d'Environnement (V0.2)
# Toutes les valeurs de référence par défaut sont renseignées et opérationnelles.
# Architecture 100% Locale : SQLite & IndexedDB sur smartphone / Aucun cloud / Zéro Docker
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environnement Général de l'Application
# ------------------------------------------------------------------------------
APP_NAME="Solar Earth"
VITE_APP_NAME="Solar Earth"
APP_VERSION="0.2.0"
VITE_APP_VERSION="0.2.0"
APP_ENV="production"
VITE_APP_ENV="production"
DEBUG=false
VITE_DEBUG=false
API_V1_PREFIX="/api/v1"
VITE_API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO"
PORT=3000

# ------------------------------------------------------------------------------
# 2. Base de Données Locale (SQLite 3 embarqué sur téléphone / PWA)
# ------------------------------------------------------------------------------
DATABASE_URL="sqlite:///./solar_earth.db"
VITE_DATABASE_URL="sqlite:///./solar_earth.db"

# ------------------------------------------------------------------------------
# 3. Fournisseur Solaire Principal : PVGIS (Commission Européenne JRC)
# API publique gratuite, sans clé secrète requise
# ------------------------------------------------------------------------------
PVGIS_BASE_URL="https://re.jrc.ec.europa.eu/api/v5_3/"
VITE_PVGIS_BASE_URL="https://re.jrc.ec.europa.eu/api/v5_3/"
PVGIS_ENABLED=true
VITE_PVGIS_ENABLED=true

# ------------------------------------------------------------------------------
# 4. Politiques HTTP, Quotas & Cache (Respect des quotas JRC)
# ------------------------------------------------------------------------------
PVGIS_CACHE_TTL_DAYS=30
VITE_PVGIS_CACHE_TTL_DAYS=30
PVGIS_RATE_LIMIT_PER_MINUTE=20
VITE_PVGIS_RATE_LIMIT_PER_MINUTE=20
PROVIDER_REQUEST_TIMEOUT_SECONDS=15.0
VITE_PROVIDER_REQUEST_TIMEOUT_SECONDS=15.0
PROVIDER_MAX_RETRIES=3
VITE_PROVIDER_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 5. Fournisseurs Complémentaires (NASA POWER, NOAA SWPC, EUMETSAT)
# ------------------------------------------------------------------------------
NASA_POWER_BASE_URL="https://power.larc.nasa.gov/api/temporal/"
VITE_NASA_POWER_BASE_URL="https://power.larc.nasa.gov/api/temporal/"
NASA_POWER_ENABLED=false
VITE_NASA_POWER_ENABLED=false
NASA_POWER_API_KEY="DEMO_KEY"
VITE_NASA_POWER_API_KEY="DEMO_KEY"

NOAA_BASE_URL="https://services.swpc.noaa.gov/"
VITE_NOAA_BASE_URL="https://services.swpc.noaa.gov/"
NOAA_ENABLED=false
VITE_NOAA_ENABLED=false

EUMETSAT_BASE_URL="https://data.eumetsat.int/"
VITE_EUMETSAT_BASE_URL="https://data.eumetsat.int/"
EUMETSAT_ENABLED=false
VITE_EUMETSAT_ENABLED=false
EUMETSAT_CONSUMER_KEY="eumetsat_consumer_key_placeholder"
EUMETSAT_CONSUMER_SECRET="eumetsat_consumer_secret_placeholder"

# ------------------------------------------------------------------------------
# 6. Configuration Client Frontend & PWA Mobile
# ------------------------------------------------------------------------------
VITE_API_BASE_URL="/api/v1"
